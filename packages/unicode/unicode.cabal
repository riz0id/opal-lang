cabal-version: 3.4

name:        unicode
category:    Data
version:     1.0.0
synopsis:    Hand-rolled UTF-8 codec over raw pointer arenas.
description:
  A low-level UTF-8 encoding / decoding library built on
  pinned-memory @Ptr Word8@ arenas with hand-unboxed GHC primops.
  Distinct from @text@\/@bytestring@ — this library trades the
  high-level abstractions for direct pointer access. Safe boxed
  APIs validate continuation bytes, reject overlong / surrogate /
  out-of-range code points, and bounds-check pointer reads.
  Unchecked unboxed primops are exposed via @Data.Unicode.Prim@ for
  callers that want the fast path.

author:       jacob leach
maintainer:   jacobleach@protonmail.com
copyright:    2022, Jacob Leach
homepage:     https://github.com/riz0id/opal
license:      ISC
license-file: LICENSE
build-type:   Simple

extra-source-files:
  CHANGELOG.md
  README.md

common common
  default-language: Haskell2010

  default-extensions:
    BlockArguments DeriveDataTypeable DeriveFunctor DeriveGeneric DeriveLift
    DerivingStrategies ImportQualifiedPost LambdaCase MagicHash RankNTypes
    ScopedTypeVariables TypeApplications ViewPatterns

  ghc-options:
    -O2
    -fsimplifier-phases=20

    -Wall
    -Wcompat
    -Wcpp-undef
    -Widentities
    -Wmissing-export-lists

    -ddump-to-file
    -ddump-stg-final
    -ddump-simpl
    -dppr-cols=120
    -dsuppress-module-prefixes
    -dsuppress-uniques

    -ddump-rules
    -ddump-rule-firings
    -ddump-rule-rewrites

    -- Build with `-haddock` to the haskell-language-server feature that
    -- displays documentation on hover.
    -haddock

  build-depends:
    , base
    , hashable

library
  import:         common
  hs-source-dirs: src

  ghc-options:
    -O2

  build-depends:
    , primitive
    , template-haskell

  exposed-modules:
    Data.Unicode
    Data.Unicode.Prim
    Data.Unicode.TH

test-suite unicode-test
  import:         common
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Test.hs

  ghc-options:
    -threaded
    -rtsopts
    "-with-rtsopts=-N"

  build-depends:
    , hedgehog
    , primitive
    , tasty
    , tasty-hedgehog
    , unicode

  other-modules:
    Test.Data.Unicode
